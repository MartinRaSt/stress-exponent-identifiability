@echo off
REM Project: Sammon mapping revisited - adaptive weighting, a scalable solver
REM          and a temporal extension (alpha-Sammon)
REM Authors: Martin Radvansky <martin.radvansky@vsb.cz>
REM          Martin Radvansky, Jr. <martin.radvansky1@vsb.cz>
REM Affiliation: Department of Computer Science, Faculty of Electrical Engineering
REM              and Computer Science, VSB - Technical University of Ostrava,
REM              17. listopadu 2172/15, 708 00 Ostrava-Poruba, Czech Republic
REM Created: 2026-09-14
REM License: see the LICENSE file in the repository root
REM
REM Q1 step 2 (reserse/2026-09-14_specifikace_rozsireni_q1.md, A.9 - "Run
REM order", item 2) - chain of steps for the regime L hold-out candidates, AFTER
REM `src\run_screen_regime_candidates.bat full` has already run and the author
REM has confirmed the list of eligible ones (step 1, run SEPARATELY BEFORE this
REM script):
REM   1. dataset_properties --datasets holdout   (K1 on the hold-out set)
REM   2. exp1_dr_benchmark --datasets holdout --tier tier1  (15 main methods)
REM   3. exp6_alpha_curves --datasets holdout    (alpha curves on the hold-out set)
REM   4. exp1_dr_benchmark --datasets holdout --tier tier2  (6 remaining methods)
REM   5. exp1_cluster_geometry                   (recompute over ALL saved embeddings)
REM   6. fit_alpha_rule --full                    (check agreement with the frozen rule, A.5)
REM   7. exp1_regime_stratified                   (update the stratified table)
REM   8. exp1_holdout_confirmatory                (F_A1-F_A7)
REM   9. power_analysis_regime                    (A.7)
REM  10. fig_holdout_paired, fig_regime_map        (figures)
REM  11. run_main.bat full --no-figures            (statistics/tables/macros, WITHOUT figures
REM                                                  - those are already generated by step 10 + make_figures.bat)
REM
REM Each step, on error, STOPS the following steps (they depend on each other - resume/
REM checkpoint ensures already completed combinations are not recomputed).
REM Parameter: full (default) | quick | smoke. Sleep is disabled by
REM each called run_*.bat itself (no_sleep_on/off), here additionally for the whole chain.
setlocal
cd /d "%~dp0.."
call "%~dp0common\no_sleep_on.bat"
set MODE=%1
if "%MODE%"=="" set MODE=full
set LOGDIR=results\logs
if not exist "%LOGDIR%" mkdir "%LOGDIR%"
echo [%DATE% %TIME%] run_q1_step2_datasets start (mode=%MODE%) >> "%LOGDIR%\run_q1_step2_datasets.log"

echo === 1/11 dataset_properties --datasets holdout ===
"venv\python.exe" -m src.experiments.dataset_properties --%MODE% --datasets holdout
set RC1=%ERRORLEVEL%
if not "%RC1%"=="0" (
    echo ERROR: dataset_properties finished with code %RC1% - stopping.
    goto :summary
)

echo === 2/11 exp1_dr_benchmark --datasets holdout --tier tier1 ===
"venv\python.exe" -m src.experiments.exp1_dr_benchmark --%MODE% --datasets holdout --tier tier1
set RC2=%ERRORLEVEL%
if not "%RC2%"=="0" (
    echo ERROR: exp1_dr_benchmark ^(tier1^) finished with code %RC2% - stopping.
    goto :summary
)

echo === 3/11 exp6_alpha_curves --datasets holdout ===
"venv\python.exe" -m src.experiments.exp6_alpha_curves --%MODE% --datasets holdout
set RC3=%ERRORLEVEL%
if not "%RC3%"=="0" (
    echo ERROR: exp6_alpha_curves finished with code %RC3% - stopping.
    goto :summary
)

echo === 4/11 exp1_dr_benchmark --datasets holdout --tier tier2 ===
"venv\python.exe" -m src.experiments.exp1_dr_benchmark --%MODE% --datasets holdout --tier tier2
set RC4=%ERRORLEVEL%
if not "%RC4%"=="0" (
    echo ERROR: exp1_dr_benchmark ^(tier2^) finished with code %RC4% - stopping.
    goto :summary
)

echo === 5/11 exp1_cluster_geometry ===
call src\run_exp1_cluster_geometry.bat %MODE%
set RC5=%ERRORLEVEL%
if not "%RC5%"=="0" (
    echo ERROR: exp1_cluster_geometry finished with code %RC5% - stopping.
    goto :summary
)

echo === 6/11 fit_alpha_rule --full (check agreement with the frozen rule) ===
call src\run_fit_alpha_rule.bat %MODE%
set RC6=%ERRORLEVEL%
if not "%RC6%"=="0" (
    echo ERROR: fit_alpha_rule finished with code %RC6% - stopping.
    goto :summary
)

echo === 7/11 exp1_regime_stratified ===
call src\run_exp1_regime_stratified.bat %MODE%
set RC7=%ERRORLEVEL%
if not "%RC7%"=="0" (
    echo ERROR: exp1_regime_stratified finished with code %RC7% - stopping.
    goto :summary
)

echo === 8/11 exp1_holdout_confirmatory ===
call src\run_exp1_holdout_confirmatory.bat %MODE%
set RC8=%ERRORLEVEL%
if not "%RC8%"=="0" (
    echo ERROR: exp1_holdout_confirmatory finished with code %RC8% - stopping.
    goto :summary
)

echo === 9/11 power_analysis_regime ===
call src\run_power_analysis_regime.bat %MODE%
set RC9=%ERRORLEVEL%

echo === 10/11 fig_holdout_paired, fig_regime_map ===
"venv\python.exe" -m src.figures.fig_holdout_paired --%MODE%
set RC10a=%ERRORLEVEL%
"venv\python.exe" -m src.figures.fig_regime_map --%MODE%
set RC10b=%ERRORLEVEL%

echo === 11/11 run_main.bat %MODE% --no-figures ===
call src\run_main.bat %MODE% --no-figures
set RC11=%ERRORLEVEL%

:summary
echo ============================================================
echo run_q1_step2_datasets (mode=%MODE%) summary:
echo   1 dataset_properties (holdout)      : %RC1%
echo   2 exp1_dr_benchmark (tier1)         : %RC2%
echo   3 exp6_alpha_curves (holdout)       : %RC3%
echo   4 exp1_dr_benchmark (tier2)         : %RC4%
echo   5 exp1_cluster_geometry             : %RC5%
echo   6 fit_alpha_rule                    : %RC6%
echo   7 exp1_regime_stratified            : %RC7%
echo   8 exp1_holdout_confirmatory         : %RC8%
echo   9 power_analysis_regime             : %RC9%
echo  10 figures (holdout_paired,regime_map): %RC10a%/%RC10b%
echo  11 run_main --no-figures             : %RC11%
echo [%DATE% %TIME%] run_q1_step2_datasets done >> "%LOGDIR%\run_q1_step2_datasets.log"
call "%~dp0common\no_sleep_off.bat"
endlocal
